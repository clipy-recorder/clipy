{
  "name": "clipy-local",
  "private": true,
  "description": "Clipy local edition: record your screen, build an AREC on your machine, hand it to an AI agent.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-from-monorepo.mjs",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test && node scripts/plugin-pins.test.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test:plugins": "node scripts/plugin-pins.test.mjs && node --experimental-transform-types --loader ./scripts/plugin-test-loader.mjs --test scripts/plugin-record-helpers.test.mjs"
  },
  "packageManager": "pnpm@10.18.0",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
