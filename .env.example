# Clipy Local — environment variable reference
# Copy this file to .env and fill in the values you need.
# All variables are optional. Without any set, Clipy uses local on-device
# transcription and rules-only moment detection — nothing leaves your machine.

# ---------------------------------------------------------------------------
# ffmpeg / ffprobe paths (optional)
# ---------------------------------------------------------------------------
# By default Clipy looks for ffmpeg and ffprobe on PATH.
# Set these if you have installed them somewhere else.
#
# CLIPY_FFMPEG=/usr/local/bin/ffmpeg
# CLIPY_FFPROBE=/usr/local/bin/ffprobe
#
# Windows example:
# CLIPY_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# CLIPY_FFPROBE=C:\ffmpeg\bin\ffprobe.exe

# ---------------------------------------------------------------------------
# Config file location (optional)
# ---------------------------------------------------------------------------
# Clipy stores its settings in a JSON file. The default path is platform-
# specific (~/.config/clipy/config.json on Linux/macOS,
# %APPDATA%\Clipy\config.json on Windows).
# Override it here to use a custom location.
#
# CLIPY_CONFIG_PATH=/path/to/your/clipy-config.json

# ---------------------------------------------------------------------------
# Model provider for spoken moment detection (optional)
# ---------------------------------------------------------------------------
# Clipy can use an AI model to detect "spoken" key moments — things like
# "this button" or "it breaks here". Without a provider, only rule-based
# moment detection runs (highlights, clicks, pointer rests).
#
# Supported presets: openrouter, openai, gemini, groq, ollama, lmstudio, custom
#
# --- OpenRouter ---
# CLIPY_MODEL_PRESET=openrouter
# CLIPY_MODEL_API_KEY=sk-or-...
# CLIPY_MODEL_MODEL=google/gemini-flash-1.5          # optional, has a default

# --- OpenAI ---
# CLIPY_MODEL_PRESET=openai
# CLIPY_MODEL_API_KEY=sk-...
# CLIPY_MODEL_MODEL=gpt-4o-mini                      # optional, has a default

# --- Google Gemini ---
# CLIPY_MODEL_PRESET=gemini
# CLIPY_MODEL_API_KEY=AIza...
# CLIPY_MODEL_MODEL=gemini-1.5-flash                 # optional, has a default

# --- Groq ---
# CLIPY_MODEL_PRESET=groq
# CLIPY_MODEL_API_KEY=gsk_...
# CLIPY_MODEL_MODEL=llama-3.1-8b-instant             # optional, has a default

# --- Ollama (local, nothing leaves the machine) ---
# CLIPY_MODEL_PRESET=ollama
# CLIPY_MODEL_MODEL=llama3.2                         # required for ollama
# CLIPY_MODEL_BASE_URL=http://localhost:11434        # optional, default shown

# --- LM Studio (local, nothing leaves the machine) ---
# CLIPY_MODEL_PRESET=lmstudio
# CLIPY_MODEL_MODEL=meta-llama-3.1-8b-instruct       # required for lmstudio
# CLIPY_MODEL_BASE_URL=http://localhost:1234          # optional, default shown

# --- Custom OpenAI-compatible endpoint ---
# CLIPY_MODEL_PRESET=custom
# CLIPY_MODEL_BASE_URL=https://my-proxy.example.com/v1
# CLIPY_MODEL_API_KEY=...                            # optional
# CLIPY_MODEL_MODEL=my-model-name                   # required for custom

# ---------------------------------------------------------------------------
# Transcription provider (optional)
# ---------------------------------------------------------------------------
# How to turn speech into text. Defaults to the local "English, fast" model
# (NVIDIA Parakeet TDT-CTC 110M, downloaded on first use, nothing leaves your
# machine). Set CLIPY_TRANSCRIBE to a provider name to use a cloud service.
#
# Supported values: none, local, openai, groq, openai-compatible,
#                   deepgram, assemblyai, elevenlabs, gemini
#
# CLIPY_TRANSCRIBE=local                             # default — on-device
# CLIPY_TRANSCRIBE=none                              # skip transcription entirely

# --- OpenAI Whisper (audio sent to OpenAI) ---
# CLIPY_TRANSCRIBE=openai
# CLIPY_TRANSCRIBE_API_KEY=sk-...
# CLIPY_TRANSCRIBE_MODEL=whisper-1                  # optional, has a default

# --- Groq (audio sent to Groq) ---
# CLIPY_TRANSCRIBE=groq
# CLIPY_TRANSCRIBE_API_KEY=gsk_...
# CLIPY_TRANSCRIBE_MODEL=whisper-large-v3-turbo     # optional, has a default

# --- Deepgram (audio sent to Deepgram) ---
# CLIPY_TRANSCRIBE=deepgram
# CLIPY_TRANSCRIBE_API_KEY=...
# CLIPY_TRANSCRIBE_MODEL=nova-3                     # optional, has a default

# --- AssemblyAI (audio sent to AssemblyAI) ---
# CLIPY_TRANSCRIBE=assemblyai
# CLIPY_TRANSCRIBE_API_KEY=...

# --- ElevenLabs (audio sent to ElevenLabs) ---
# CLIPY_TRANSCRIBE=elevenlabs
# CLIPY_TRANSCRIBE_API_KEY=sk_...

# --- Google Gemini (audio sent to Google) ---
# CLIPY_TRANSCRIBE=gemini
# CLIPY_TRANSCRIBE_API_KEY=AIza...
# CLIPY_TRANSCRIBE_MODEL=gemini-1.5-flash           # optional, has a default

# --- Custom OpenAI-compatible transcription endpoint ---
# CLIPY_TRANSCRIBE=openai-compatible
# CLIPY_TRANSCRIBE_BASE_URL=https://my-whisper.example.com/v1
# CLIPY_TRANSCRIBE_API_KEY=...                       # optional
# CLIPY_TRANSCRIBE_MODEL=my-whisper-model           # required
