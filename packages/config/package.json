{
  "name": "@clipy/local-config",
  "version": "0.1.0",
  "private": true,
  "description": "Settings for Clipy's local edition: which model provider picks spoken moments and how recordings are transcribed.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "node scripts/ensure-moments-source.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "pretest": "node scripts/ensure-moments-source.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@clipy/moments": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.4"
  },
  "engines": { "node": ">=20.19" }
}
